# Copy to .env.local and fill in. Never commit .env.local.

# Local database: ./install.sh (scripts/setup-db.sh) writes these for you. Nothing to fill in.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# AI: none needed — MarkOS runs on Claude Code with your Claude plan.
# Optional, only if you pick these models for an agent in Settings:
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Sending email (outreach, pitches, customer emails) through Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: posting approved content to X / LinkedIn
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional extras
FIRECRAWL_API_KEY=
REPLICATE_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
